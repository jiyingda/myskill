{
  "name": "myskill",
  "version": "0.1.0",
  "private": true,
  "description": "本地工具：管理多个 agent (Cursor / Claude / Cline 等) 下散落在不同目录的 skill，可同步、移动、删除、预览。",
  "type": "module",
  "main": "server.js",
  "bin": {
    "myskill": "bin/myskill.js"
  },
  "files": [
    "bin/",
    "lib/",
    "public/",
    "server.js",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/myskill.js",
    "start:no-open": "node bin/myskill.js --no-open",
    "dev": "node --watch bin/myskill.js",
    "link": "npm link",
    "build:binary": "bun build ./bin/myskill-bun.js --compile --outfile dist/myskill",
    "build:macos-arm64": "bun build ./bin/myskill-bun.js --compile --target=bun-darwin-arm64 --outfile dist/myskill-darwin-arm64",
    "build:macos-x64":   "bun build ./bin/myskill-bun.js --compile --target=bun-darwin-x64   --outfile dist/myskill-darwin-x64",
    "build:linux-arm64": "bun build ./bin/myskill-bun.js --compile --target=bun-linux-arm64  --outfile dist/myskill-linux-arm64",
    "build:linux-x64":   "bun build ./bin/myskill-bun.js --compile --target=bun-linux-x64    --outfile dist/myskill-linux-x64",
    "build:windows-x64": "bun build ./bin/myskill-bun.js --compile --target=bun-windows-x64  --outfile dist/myskill-windows-x64.exe",
    "build:all": "npm run build:macos-arm64 && npm run build:macos-x64 && npm run build:linux-arm64 && npm run build:linux-x64 && npm run build:windows-x64"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
